{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orzarua",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Public (non-secret) runtime vars. The anon/publishable key is safe to expose.
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, CARDCOM_*, RESEND_API_KEY, CRON_SECRET,
  // UNSUBSCRIBE_SECRET) must be set with `wrangler secret put` — never here.
  "vars": {
    "SUPABASE_URL": "https://kekspqdnhnivojivrwvy.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imtla3NwcWRuaG5pdm9qaXZyd3Z5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg0MjE5MzAsImV4cCI6MjA5Mzk5NzkzMH0.CHMEG_21kX24Qe18kyQHptXFmiPIOBlYg0hHEBIdr7Q",
    "APP_URL": "https://orzadik.com",
  },
  // Serve the Worker on the real domain (Cloudflare auto-creates DNS + TLS).
  "routes": [
    { "pattern": "orzadik.com", "custom_domain": true },
    { "pattern": "www.orzadik.com", "custom_domain": true },
  ],
}
