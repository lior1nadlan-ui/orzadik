{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orzarua",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  // Retain Worker logs. Every failure path in the crons, the email sender and
  // the CardCom webhook currently ends at console.* — without this, those lines
  // are gone the moment the request finishes, so a cron that silently stopped
  // (an expired Resend key stops order confirmations, cart reminders AND review
  // requests at once) leaves no evidence to look at afterwards.
  "observability": { "enabled": true },
  // Public (non-secret) runtime vars. The anon/publishable key is safe to expose.
  // Secrets (SUPABASE_SERVICE_ROLE_KEY, CARDCOM_*, RESEND_API_KEY, CRON_SECRET,
  // UNSUBSCRIBE_SECRET) must be set with `wrangler secret put` — never here.
  "vars": {
    "SUPABASE_URL": "https://whtjslgrrfzehivrknuv.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_iIXlA6UOH_jEMubtd2nW9A_bG9hPbaF",
    "APP_URL": "https://orzadik.com",
    // Telegram alerts. The chat id is NOT a secret — it identifies a
    // conversation and is useless without the bot token, which stays a Worker
    // secret. It lives here rather than in the dashboard because `wrangler
    // deploy` REPLACES the Worker's plain-text vars with whatever this file
    // lists: a var added by hand in the dashboard survives until the next
    // deploy and then silently disappears, taking the alerts with it. (Secrets
    // are not touched by a deploy, which is why the token is safe there.)
    "TELEGRAM_CHAT_ID": "7552125260",
  },
  // Scheduled jobs. Each expression below MUST have a matching key in the JOBS
  // map in src/nitro/cron.ts (Cloudflare hands the schedule back verbatim, so an
  // unmapped string just logs "no job mapped" and does nothing). The same jobs
  // stay externally callable at /api/cron/* behind CRON_SECRET.
  //   "0 7 * * *"   → daily 07:00 UTC: post-delivery review requests
  //   "*/5 * * * *" → every 5 min: send the next campaign batch (~240 mails/hr)
  //   "15 * * * *"  → hourly at :15: abandoned-cart reminders (carts 1h–30d old,
  //                   ≤100 per tick, one reminder per cart ever)
  "triggers": {
    "crons": ["0 7 * * *", "*/5 * * * *", "15 * * * *", "*/10 * * * *", "40 3 * * *"],
  },
  // Serve the Worker on the real domain (Cloudflare auto-creates DNS + TLS).
  "routes": [
    { "pattern": "orzadik.com", "custom_domain": true },
    { "pattern": "www.orzadik.com", "custom_domain": true },
  ],
}
